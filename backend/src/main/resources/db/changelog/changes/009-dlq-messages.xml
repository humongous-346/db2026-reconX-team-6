<?xml version="1.0" encoding="UTF-8"?>
<!--
 ============================================================================
 TICKET-ADV136 — dlq_messages table
 WHAT:    One row per message the trade-events DLQ recoverer (TICKET-ADV134)
          quarantines, plus the original topic/partition/offset and the
          exception message that caused the failure.
 WHY:     Without a persisted record, a DLQ'd message only exists on the
          Kafka topic itself — the admin replay endpoint (TICKET-ADV136)
          needs a queryable-by-eventId store to look messages up by id.
 ============================================================================
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="009-create-dlq-messages" author="trainer">
        <createTable tableName="dlq_messages">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="event_id" type="VARCHAR(36)"><constraints nullable="false" unique="true"/></column>
            <column name="trade_ref" type="VARCHAR(30)"><constraints nullable="false"/></column>
            <column name="event_type" type="VARCHAR(30)"><constraints nullable="false"/></column>
            <column name="event_timestamp" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="actor" type="VARCHAR(100)"/>
            <!-- Same VARCHAR-not-TEXT reasoning as audit_log (006) — keeps
                 H2's PostgreSQL-mode dialect and real Postgres schema-aligned
                 under Hibernate's ddl-auto=validate. -->
            <column name="before_state" type="VARCHAR(1000000)"/>
            <column name="after_state" type="VARCHAR(1000000)"/>
            <column name="original_topic" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <!-- Named kafka_partition (not "partition") — this schema already
                 uses PARTITION BY heavily elsewhere; avoid any ambiguity with
                 the reserved-ish keyword. -->
            <column name="kafka_partition" type="INT"><constraints nullable="false"/></column>
            <column name="kafka_offset" type="BIGINT"><constraints nullable="false"/></column>
            <column name="reason" type="VARCHAR(1000)"/>
            <column name="first_seen" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <createIndex tableName="dlq_messages" indexName="idx_dlq_messages_trade_ref">
            <column name="trade_ref"/>
        </createIndex>
        <rollback>
            <dropTable tableName="dlq_messages"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
